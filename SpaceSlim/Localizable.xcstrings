    "Blurry photos and duplicate/similar copies will be removed from Photos, freeing about %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إزالة الصور المشوشة والنسخ المكررة/المتشابهة من الصور، مما يوفر حوالي %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unscharfe Fotos und doppelte/ähnliche Kopien werden aus „Fotos“ entfernt, wodurch etwa %@ frei werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos borrosas y las copias duplicadas o similares se eliminarán de Fotos, liberando unos %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos floues et les copies en double ou similaires seront supprimées de Photos, libérant environ %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "धुंधली फ़ोटो और डुप्लिकेट/समान प्रतियां फ़ोटो से हटा दी जाएंगी, जिससे लगभग %@ जगह खाली हो जाएगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto sfocate e le copie duplicate/simili verranno rimosse da Foto, liberando circa %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ぼやけた写真や重複・類似のコピーが写真から削除され、約 %@ の空き容量が確保されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흐린 사진과 중복/유사한 복사본이 사진에서 제거되어 약 %@의 공간이 확보됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos desfocadas e cópias duplicadas/semelhantes serão removidas das Fotos, liberando cerca de %@."
          }
        }
      }
    },
